{
    "name": "crappital-client",
    "version": "1.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "generate": "openapi-generator-cli generate -g typescript-angular -i https://crappital-production.up.railway.app/openapi.json -o src/app/generated/core-api --additional-properties=ngVersion=19.2,stringEnums=true,enumPropertyNaming=UPPERCASE,fileNaming=kebab-case --generate-alias-as-model",
        "build": "npm run generate && ng build",
        "generate-docker": "openapi-generator-cli generate -g typescript-angular -i http://server:5000/openapi.json -o src/app/generated/core-api --additional-properties=ngVersion=19.2,stringEnums=true,enumPropertyNaming=UPPERCASE,fileNaming=kebab-case --generate-alias-as-model",
        "build-docker": "npm run generate-docker && ng build",
        "watch": "ng build --watch --configuration development",
        "format": "prettier --write 'src/**/*.{ts,json,less,html}'",
        "test": "ng test",
        "clean": "rimraf src/api-client"
    },
    "private": true,
    "dependencies": {
        "@angular/cdk": "^19.2.9",
        "@angular/common": "^19.2.0",
        "@angular/compiler": "^19.2.0",
        "@angular/core": "^19.2.0",
        "@angular/forms": "^19.2.0",
        "@angular/material": "^19.2.9",
        "@angular/platform-browser": "^19.2.0",
        "@angular/platform-browser-dynamic": "^19.2.0",
        "@angular/router": "^19.2.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^19.2.7",
        "@angular/cli": "^19.2.7",
        "@angular/compiler-cli": "^19.2.0",
        "@openapitools/openapi-generator-cli": "^2.18.4",
        "@types/jasmine": "~5.1.0",
        "jasmine-core": "~5.6.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "typescript": "~5.7.2"
    }
}
