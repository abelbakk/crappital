{
  "name": "crappital ci/cd devcontainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [
    // this one has to be forwarded manually later, otherwise a race condition between this
    // and the proxying of devcontainer make it impossible to set up
    // other option would be to forward it from the cluster, but this is probably easier to have
    // 41080, // app (via nginx)
    8080, // Jenkins
    9090, // Prometheus
    3000 // Grafana
  ],
  "portsAttributes": {
    "8080": {
      "label": "jenkins"
    },
    "9090": {
      "label": "prometheus"
    },
    "3000": {
      "label": "grafana"
    },
    "41080": {
      "label": "crappital",
      "onAutoForward": "ignore"
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  }
}
