{
  "name": "crappital ci/cd devcontainer",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [
    // these two have to be forwarded manually later, otherwise a race condition between this
    // and the proxying of devcontainer make it impossible to set up
    // 41080, // app (via nginx)
    // 41443, // app (via nginx)
    8080 // Jenkins
  ],
  "remoteUser": "root",
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
